# ─── Inherited from Buổi 08 ───────────────────────────────────────────────────
GEMINI_API_KEY=AQ.Ab8RN6J2pT9ZSzyneMk9qY70zUnX0n202H6phhe0LdliUUkdYw
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIM=768
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
RAG_MAX_DISTANCE=0.45
BM25_CANDIDATES=20
SEMANTIC_CANDIDATES=20
RRF_K=60
RRF_BM25_WEIGHT=1.0
RRF_SEMANTIC_WEIGHT=1.0
RERANK_CANDIDATES=20
FINAL_TOP_K=5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MAX_LENGTH=512
RERANK_BATCH_SIZE=4
RERANK_MIN_SCORE=0.50
RERANK_DEVICE=auto

# ─── Buổi 09 — Multi-Query ────────────────────────────────────────────────────
# Số lượng variant queries LLM sinh ra thêm ngoài Q0
MULTI_QUERY_COUNT=3
# Độ dài tối đa (ký tự) mỗi variant query
MULTI_QUERY_MAX_CHARS=300
# Temperature khi sinh variant (thấp → ổn định hơn)
MULTI_QUERY_TEMPERATURE=0.2
# RRF weight cho Q0 gốc trong cross-query fusion
MULTI_QUERY_ORIGINAL_WEIGHT=1.5
# RRF weight cho mỗi variant Qi trong cross-query fusion
MULTI_QUERY_VARIANT_WEIGHT=1.0
# Hằng số k trong công thức cross-query RRF
MULTI_QUERY_RRF_K=60
# Số candidate lấy ra cho MỖI query variant (trước cross-query RRF)
PER_QUERY_CANDIDATES=12

# ─── Buổi 09 — Parent-Document Retrieval ─────────────────────────────────────
# Giới hạn ký tự tối đa của parent document đưa vào context
PARENT_MAX_CHARS=6000
# Số child hit tối đa tính score đại diện cho một parent
PARENT_SCORE_CHILD_LIMIT=3
# Hằng số k trong công thức parent aggregation RRF
PARENT_RRF_K=60
# Số parent candidates giữ lại sau aggregation (trước rerank)
PARENT_CANDIDATES=10
# Số parent document cuối cùng đưa vào generation context
FINAL_PARENT_TOP_K=3
# Ngân sách ký tự tổng cho toàn bộ context gửi LLM
TOTAL_CONTEXT_MAX_CHARS=16000
